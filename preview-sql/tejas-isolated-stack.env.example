# PLACEHOLDERS ONLY — copy to a gitignored local file if needed.
# Preferred: use preview-sql/bootstrap-tejas-app-stack-isolated.ps1 (Credential Manager).
# Never commit real values. Never paste secrets into chat.
# Must NOT be production project zapccpipwxduzlnvjdmy.

# Isolated HTTPS API origin (required). Example shape only:
TEJAS_ISOLATED_SUPABASE_URL=https://YOUR_ISOLATED_PROJECT_REF.supabase.co

# Isolated server key for local Next.js / recovery runners only (required).
# Use the isolated project's service_role OR secret key.
# NEVER use this as the Phase 38 Storage backup-reader credential.
TEJAS_ISOLATED_SERVICE_ROLE_KEY=REPLACE_WITH_ISOLATED_SERVER_KEY_ONLY

# Optional: isolated DB password for pg_restore into the disposable project pooler.
TEJAS_ISOLATED_DB_PASSWORD=REPLACE_WITH_ISOLATED_DB_PASSWORD_ONLY

# Optional local staff cookie tests (synthetic):
# TEJAS_ADMIN_TOKEN=local-test-token-only
